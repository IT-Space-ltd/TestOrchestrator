  "SecretForm": {
    "name": {
      "type": "StringField",
      "label": "Reference name"
    },
    "kind": {
      "type": "RadioField",
      "label": "Kind",
      "choices": [
        [
          "git",
          "Git \u2014 HTTPS repository authentication"
        ],
        [
          "runtime",
          "KRE invocation secret"
        ],
        [
          "license",
          "KRE offline license file (.lic)"
        ]
      ],
      "default": "git"
    },
    "value": {
      "type": "PasswordField",
      "label": "Credential value",
      "description": "Git (HTTPS only): user:token \u2014 e.g. git:ghp_\u2026 \u2014 split at the first colon; a bare token is used as the username (PAT convention). SSH remotes use the host ssh agent or the worker-side key path \u2014 never a stored key. KRE: a sensitive value used by the invocation (license key or project token) that must be redacted from logs/artifacts. License kind: the exact contents of a genuine Katalon-issued .lic offline license file (machine-bound to the target's execution account)."
    },
    "description": {
      "type": "StringField",
      "label": "Description"
    }
  },
